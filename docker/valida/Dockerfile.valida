FROM ghcr.io/lita-xyz/llvm-valida-releases/valida-build-container:v0.10.0

WORKDIR /app

COPY ./valida/ ./valida/
COPY ./utils/ ./utils/
COPY ./guests/ ./guests/

# Build fibonacci
WORKDIR /app/valida/fibonacci
RUN cargo +valida build --release

# Build sha2
WORKDIR /app/valida/sha2
RUN cargo +valida build --release

WORKDIR /app/valida/host

# Default to fibonacci, but allow override via BENCHMARK env var
CMD ["sh", "-c", "RUSTFLAGS='-C target-cpu=native' cargo run --release --bin ${BENCHMARK:-fibonacci}"]
